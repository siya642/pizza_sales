#Extract the first 5 characters from every pizza name.
SELECT 
    LEFT(name, 5) AS first_5_characters
FROM
    pizzahut.pizza_types;

#Create a price_category column using CASE:
#Less than 10 → Cheap
#10–15 → Medium
#Greater than 15 → Expensive
SELECT 
    CASE
        WHEN price > 10 THEN 'cheap'
        WHEN price >= 10 AND price >= 15 THEN 'medium'
        WHEN price < 15 THEN 'expensive'
    END AS price
FROM
    pizzahut.pizzas;

#Create a sales_category using quantity:
#Less than 2 → Low
#2–4 → Medium
#Greater than 4 → High
SELECT 
    CASE
        WHEN quantity > 2 THEN 'low'
        WHEN quantity > 2 AND quantity > 4 THEN 'medium'
        WHEN quantity < 4 THEN 'high'
    END AS sales_category
FROM
    pizzahut.order_details
        JOIN
    pizzas ON order_details.pizza_id = pizzas.pizza_id
        JOIN
    pizza_types ON pizzas.pizza_type_id = pizza_types.pizza_type_id
GROUP BY quantity
;

#Use CASE to classify pizzas based on their size as Small, Medium, or Large, then count the pizzas in each size category.
SELECT 
    CASE
        WHEN size = 's' THEN 'small'
        WHEN size = 'M' THEN 'medium'
        WHEN size = 'L' THEN 'large'
    END AS pizza_size,
    COUNT(*) AS count_size
FROM
    pizzahut.pizzas
GROUP BY CASE
    WHEN size = 's' THEN 'small'
    WHEN size = 'M' THEN 'medium'
    WHEN size = 'L' THEN 'large'
END
;

#Find all pizzas whose price is greater than the average pizza price.
SELECT 
    pizza_type_id, price
FROM
    pizzahut.pizzas
WHERE
    price > (SELECT 
            AVG(price)
        FROM
            pizzahut.pizzas)
;
#Find the pizza or pizzas with the highest price using a subquery.
SELECT 
    pizza_type_id, price
FROM
    pizzahut.pizzas
WHERE
    price = (SELECT 
            MAX(price)
        FROM
            pizzahut.pizzas);


#Find pizzas whose total revenue is greater than the average revenue generated per pizza.
SELECT 
    pizza_type_id, SUM(quantity * price) AS total_revenue
FROM
    pizzahut.order_details
        JOIN
    pizzas ON order_details.pizza_id = pizzas.pizza_id
GROUP BY pizza_type_id
HAVING SUM(quantity * price) > (SELECT 
        AVG(total_revenue)
    FROM
        (SELECT 
            pizza_type_id, SUM(quantity * price) AS total_revenue
        FROM
            pizzahut.order_details
        JOIN pizzas ON order_details.pizza_id = pizzas.pizza_id
        GROUP BY pizza_type_id) AS revenue);

#Use RANK() to rank pizzas based on their total revenue from highest to lowest.
select name,sum(quantity*price) as total_revenue,
rank()
over(order by sum(quantity*price)desc) as ranked_revenue
from pizzahut.pizza_types
join pizzas on pizza_types.pizza_type_id = pizzas.pizza_type_id
join order_details on pizzas.pizza_id = order_details.pizza_id
group by name;

#Use RANK() with PARTITION BY to find the revenue rank of each pizza within its category.
select name,category ,sum(quantity*price) as total_revenue,
rank()
over(partition by category
order by sum(quantity*price) desc) as ranked_revenue
from pizzahut.pizza_types
join pizzas on pizza_types.pizza_type_id = pizzas.pizza_type_id
join order_details on pizzas.pizza_id = order_details.pizza_id
group by name,category
order by category desc;

#Use ROW_NUMBER() to assign a unique ranking to pizzas based on quantity sold.
select name,sum(quantity) as quantity_sold,
row_number()
over(order by sum(quantity)desc) as ranking_quantity
from pizzahut.pizza_types
join pizzas on pizza_types.pizza_type_id = pizzas.pizza_type_id
join order_details on pizzas.pizza_id = order_details.pizza_id
group by name;

#Use SUM() OVER() to calculate the cumulative revenue by date.
select order_date,sum(quantity*price) as total_revenue,
sum(sum(quantity*price))
over(order by order_date desc
rows between unbounded preceding and current row
) as cumulative_revenue
from pizzahut.orders
join order_details on orders.order_id=order_details.order_id
join pizzas on order_details.pizza_id = pizzas.pizza_id
group by order_date
order by order_date;

#Create a CTE that calculates total revenue for each pizza, then use RANK() to find the top 3 pizzas in each category.
with pizza_revenue as(
select name,category,sum(quantity*price)as total_revenue
from pizzahut.pizza_types
join pizzas on pizza_types.pizza_type_id = pizzas.pizza_type_id
join order_details on pizzas.pizza_id = order_details.pizza_id
group by name,category ) ,
ranked_pizzas as 
(select name,category,total_revenue,
rank()
over (partition by category
order by total_revenue desc) as revenue_rank
from pizza_revenue
)
select name,category,total_revenue,revenue_rank
from ranked_pizzas
where revenue_rank<=3
order by category,revenue_rank;
