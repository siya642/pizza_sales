#Find all the unique pizza categories in the dataset.
SELECT DISTINCT
    category
FROM
    pizzahut.pizza_types;

#Find all orders where the quantity of pizzas sold is greater than 2.
SELECT 
    order_id, quantity
FROM
    pizzahut.order_details
WHERE
    quantity > 2;
select * from pizzahut.pizza_types;


#Find all pizzas whose name contains the word "chicken".
SELECT 
    pizza_type_id, name, category
FROM
    pizzahut.pizza_types
WHERE
    name LIKE '%chicken%';

#Find the total quantity of pizzas sold for each pizza category.
SELECT 
    SUM(quantity), category
FROM
    pizzahut.pizza_types
        JOIN
    pizzas ON pizza_types.pizza_type_id = pizzas.pizza_type_id
        JOIN
    order_details ON pizzas.pizza_id = order_details.pizza_id
GROUP BY category;

#Find the total revenue generated by each pizza, sorted from highest to lowest.
SELECT 
    pizza_type_id, SUM(price * quantity) AS total_revenue
FROM
    pizzahut.pizzas
        JOIN
    order_details ON order_details.pizza_id = pizzas.pizza_id
GROUP BY pizza_type_id
ORDER BY total_revenue DESC;

#Find the top 5 pizzas based on total quantity sold.
SELECT 
    name, SUM(quantity) AS total_quantity
FROM
    pizzahut.order_details
        JOIN
    pizzas ON order_details.pizza_id = pizzas.pizza_id
        JOIN
    pizza_types ON pizzas.pizza_type_id = pizza_types.pizza_type_id
GROUP BY name
ORDER BY total_quantity DESC
LIMIT 5;

#Find pizza types that have sold more than 500 pizzas in total.
SELECT 
    pizza_type_id AS pizza_type, SUM(quantity) AS total_quantity
FROM
    pizzahut.order_details
        JOIN
    pizzas ON pizzas.pizza_id = order_details.pizza_id
GROUP BY pizza_type
HAVING total_quantity > 500;

#Find all pizzas with a price greater than $15 and sort them from most expensive to cheapest.
select pizza_type_id,price
from pizzahut.pizzas
where (price>15) 
order by price desc;

#Join the order details table with the pizza table and display order_id, pizza_name, quantity, and price
SELECT 
    order_id, name, quantity, price
FROM
    pizzahut.order_details
        JOIN
    pizzas ON order_details.pizza_id = pizzas.pizza_id
        JOIN
    pizza_types ON pizzas.pizza_type_id = pizza_types.pizza_type_id;

#Find the total revenue generated by each pizza category.
SELECT 
    category, SUM(price * quantity) AS total_revenue
FROM
    pizzahut.order_details
        JOIN
    pizzas ON pizzas.pizza_id = order_details.pizza_id
        JOIN
    pizza_types ON pizza_types.pizza_type_id = pizzas.pizza_type_id
GROUP BY category
ORDER BY total_revenue DESC;

